+//! HyperTask regressions for replacement of a previously granted role.
+//! Tests use the public enforcer update/enforcement boundary, with no server or database.
+use super::enforcer::tests::test_enforcer;
+use crate::{
+  act::Action,
+  entity::{ObjectType, SubjectType},
+};
+use database_entity::dto::AFRole;
+
+#[tokio::test]
+async fn hyper_role_downgrade_replaces_warm_member_and_owner_grants() {
+  let enforcer = test_enforcer().await;
+  let user = SubjectType::User(41);
+  let workspace = ObjectType::Workspace("hyper-role-transition".to_owned());
+  enforcer
+    .update_policy(user.clone(), workspace.clone(), AFRole::Member)
+    .await
+    .unwrap();
+  for _ in 0..8 {
+    assert!(enforcer
+      .enforce_policy(&41, workspace.clone(), Action::Write)
+      .await
+      .unwrap());
+  }
+  enforcer
+    .update_policy(user.clone(), workspace.clone(), AFRole::Guest)
+    .await
+    .unwrap();
+  assert!(enforcer
+    .enforce_policy(&41, workspace.clone(), Action::Read)
+    .await
+    .unwrap());
+  assert!(!enforcer
+    .enforce_policy(&41, workspace.clone(), Action::Write)
+    .await
+    .unwrap());
+  assert!(!enforcer
+    .enforce_policy(&41, workspace.clone(), AFRole::Member)
+    .await
+    .unwrap());
+
+  enforcer
+    .update_policy(user.clone(), workspace.clone(), AFRole::Owner)
+    .await
+    .unwrap();
+  assert!(enforcer
+    .enforce_policy(&41, workspace.clone(), Action::Delete)
+    .await
+    .unwrap());
+  enforcer
+    .update_policy(user.clone(), workspace.clone(), AFRole::Guest)
+    .await
+    .unwrap();
+  enforcer
+    .update_policy(user, workspace.clone(), AFRole::Guest)
+    .await
+    .unwrap();
+  assert!(enforcer
+    .enforce_policy(&41, workspace.clone(), Action::Read)
+    .await
+    .unwrap());
+  assert!(!enforcer
+    .enforce_policy(&41, workspace.clone(), Action::Delete)
+    .await
+    .unwrap());
+  assert!(!enforcer
+    .enforce_policy(&41, workspace, Action::Write)
+    .await
+    .unwrap());
+}
+
+#[tokio::test]
+async fn hyper_role_replacement_preserves_other_users_and_workspaces() {
+  let enforcer = test_enforcer().await;
+  let first = ObjectType::Workspace("hyper-first".to_owned());
+  let second = ObjectType::Workspace("hyper-second".to_owned());
+  enforcer
+    .update_policy(SubjectType::User(41), first.clone(), AFRole::Member)
+    .await
+    .unwrap();
+  enforcer
+    .update_policy(SubjectType::User(42), first.clone(), AFRole::Owner)
+    .await
+    .unwrap();
+  enforcer
+    .update_policy(SubjectType::User(41), second.clone(), AFRole::Member)
+    .await
+    .unwrap();
+  enforcer
+    .update_policy(SubjectType::User(41), first.clone(), AFRole::Guest)
+    .await
+    .unwrap();
+  assert!(!enforcer
+    .enforce_policy(&41, first.clone(), Action::Write)
+    .await
+    .unwrap());
+  assert!(enforcer
+    .enforce_policy(&42, first, Action::Delete)
+    .await
+    .unwrap());
+  assert!(enforcer
+    .enforce_policy(&41, second, Action::Write)
+    .await
+    .unwrap());
+}
+
+use super::access::{casbin_model, cmp_role_or_level};
+use super::enforcer::AFEnforcer;
+use async_trait::async_trait;
+use casbin::{function_map::OperatorFunction, Adapter, CoreApi, Filter, MemoryAdapter, Model};
+use std::sync::{
+  atomic::{AtomicBool, Ordering},
+  Arc,
+};
+use std::time::Duration;
+use tokio::sync::Notify;
+
+#[derive(Default)]
+struct HyperAdapterControl {
+  fail_add: AtomicBool,
+  fail_remove: AtomicBool,
+  reject_add: AtomicBool,
+  reject_remove: AtomicBool,
+  pause_remove: AtomicBool,
+  entered: Notify,
+  resume: Notify,
+}
+
+struct HyperFailureAdapter {
+  inner: MemoryAdapter,
+  control: Arc<HyperAdapterControl>,
+}
+
+fn hyper_adapter_error() -> casbin::Error {
+  std::io::Error::new(
+    std::io::ErrorKind::Other,
+    "injected role policy adapter failure",
+  )
+  .into()
+}
+
+#[async_trait]
+impl Adapter for HyperFailureAdapter {
+  async fn load_policy(&mut self, model: &mut dyn Model) -> casbin::Result<()> {
+    self.inner.load_policy(model).await
+  }
+  async fn load_filtered_policy<'a>(
+    &mut self,
+    model: &mut dyn Model,
+    filter: Filter<'a>,
+  ) -> casbin::Result<()> {
+    self.inner.load_filtered_policy(model, filter).await
+  }
+  async fn save_policy(&mut self, model: &mut dyn Model) -> casbin::Result<()> {
+    self.inner.save_policy(model).await
+  }
+  async fn clear_policy(&mut self) -> casbin::Result<()> {
+    self.inner.clear_policy().await
+  }
+  fn is_filtered(&self) -> bool {
+    self.inner.is_filtered()
+  }
+  async fn add_policy(
+    &mut self,
+    section: &str,
+    kind: &str,
+    rule: Vec<String>,
+  ) -> casbin::Result<bool> {
+    self.inner.add_policy(section, kind, rule).await
+  }
+  async fn add_policies(
+    &mut self,
+    section: &str,
+    kind: &str,
+    rules: Vec<Vec<String>>,
+  ) -> casbin::Result<bool> {
+    if self.control.fail_add.load(Ordering::SeqCst) {
+      return Err(hyper_adapter_error());
+    }
+    if self.control.reject_add.load(Ordering::SeqCst) {
+      return Ok(false);
+    }
+    self.inner.add_policies(section, kind, rules).await
+  }
+  async fn remove_policy(
+    &mut self,
+    section: &str,
+    kind: &str,
+    rule: Vec<String>,
+  ) -> casbin::Result<bool> {
+    self.inner.remove_policy(section, kind, rule).await
+  }
+  async fn remove_policies(
+    &mut self,
+    section: &str,
+    kind: &str,
+    rules: Vec<Vec<String>>,
+  ) -> casbin::Result<bool> {
+    if self.control.pause_remove.load(Ordering::SeqCst) {
+      self.control.entered.notify_one();
+      self.control.resume.notified().await;
+    }
+    if self.control.fail_remove.load(Ordering::SeqCst) {
+      return Err(hyper_adapter_error());
+    }
+    if self.control.reject_remove.load(Ordering::SeqCst) {
+      return Ok(false);
+    }
+    self.inner.remove_policies(section, kind, rules).await
+  }
+  async fn remove_filtered_policy(
+    &mut self,
+    section: &str,
+    kind: &str,
+    index: usize,
+    values: Vec<String>,
+  ) -> casbin::Result<bool> {
+    self
+      .inner
+      .remove_filtered_policy(section, kind, index, values)
+      .await
+  }
+}
+
+async fn hyper_failure_enforcer() -> (Arc<AFEnforcer>, Arc<HyperAdapterControl>) {
+  let control = Arc::new(HyperAdapterControl::default());
+  let model = casbin_model().await.unwrap();
+  let adapter = HyperFailureAdapter {
+    inner: MemoryAdapter::default(),
+    control: control.clone(),
+  };
+  let mut enforcer = casbin::Enforcer::new(model, adapter).await.unwrap();
+  enforcer.add_function("cmpRoleOrLevel", OperatorFunction::Arg2(cmp_role_or_level));
+  (Arc::new(AFEnforcer::new(enforcer).await.unwrap()), control)
+}
+
+#[tokio::test]
+async fn hyper_role_adapter_failures_deny_previous_grants_and_allow_explicit_recovery() {
+  for failure in [
+    "add error",
+    "remove error",
+    "add rejected",
+    "remove rejected",
+  ] {
+    let (enforcer, control) = hyper_failure_enforcer().await;
+    let workspace_id = uuid::Uuid::new_v4();
+    let workspace = ObjectType::Workspace(workspace_id.to_string());
+    enforcer
+      .update_policy(SubjectType::User(41), workspace.clone(), AFRole::Member)
+      .await
+      .unwrap();
+    enforcer
+      .update_policy(SubjectType::User(42), workspace.clone(), AFRole::Member)
+      .await
+      .unwrap();
+    assert!(enforcer
+      .enforce_policy(&41, workspace.clone(), Action::Write)
+      .await
+      .unwrap());
+    control
+      .fail_remove
+      .store(failure == "remove error", Ordering::SeqCst);
+    control
+      .fail_add
+      .store(failure == "add error", Ordering::SeqCst);
+    control
+      .reject_remove
+      .store(failure == "remove rejected", Ordering::SeqCst);
+    control
+      .reject_add
+      .store(failure == "add rejected", Ordering::SeqCst);
+    assert!(enforcer
+      .update_policy(SubjectType::User(41), workspace.clone(), AFRole::Guest)
+      .await
+      .is_err());
+    assert!(!enforcer
+      .enforce_policy(&41, workspace.clone(), Action::Write)
+      .await
+      .unwrap());
+    assert!(!enforcer
+      .enforce_policy(&41, workspace.clone(), Action::Read)
+      .await
+      .unwrap());
+    assert!(enforcer
+      .enforce_policy(&42, workspace.clone(), Action::Write)
+      .await
+      .unwrap());
+    control.fail_add.store(false, Ordering::SeqCst);
+    control.fail_remove.store(false, Ordering::SeqCst);
+    control.reject_add.store(false, Ordering::SeqCst);
+    control.reject_remove.store(false, Ordering::SeqCst);
+    assert!(enforcer
+      .update_policy(SubjectType::User(41), workspace.clone(), AFRole::Member)
+      .await
+      .is_err());
+    enforcer
+      .mutate_workspace_roles(
+        vec![(41, workspace_id)],
+        Box::pin(async { Ok(vec![Some(AFRole::Guest)]) }),
+      )
+      .await
+      .unwrap();
+    assert!(enforcer
+      .enforce_policy(&41, workspace.clone(), Action::Read)
+      .await
+      .unwrap());
+    assert!(!enforcer
+      .enforce_policy(&41, workspace, Action::Write)
+      .await
+      .unwrap());
+  }
+}
+
+#[tokio::test]
+async fn hyper_role_cancelled_replacement_does_not_retain_a_member_write_grant() {
+  let (enforcer, control) = hyper_failure_enforcer().await;
+  let workspace_id = uuid::Uuid::new_v4();
+  let workspace = ObjectType::Workspace(workspace_id.to_string());
+  enforcer
+    .update_policy(SubjectType::User(41), workspace.clone(), AFRole::Member)
+    .await
+    .unwrap();
+  control.pause_remove.store(true, Ordering::SeqCst);
+  let update = {
+    let enforcer = enforcer.clone();
+    let workspace = workspace.clone();
+    tokio::spawn(async move {
+      enforcer
+        .update_policy(SubjectType::User(41), workspace, AFRole::Guest)
+        .await
+    })
+  };
+  tokio::time::timeout(Duration::from_secs(2), control.entered.notified())
+    .await
+    .unwrap();
+  update.abort();
+  assert!(update.await.unwrap_err().is_cancelled());
+  assert!(!enforcer
+    .enforce_policy(&41, workspace.clone(), Action::Write)
+    .await
+    .unwrap());
+  control.pause_remove.store(false, Ordering::SeqCst);
+  assert!(enforcer
+    .update_policy(SubjectType::User(41), workspace.clone(), AFRole::Member)
+    .await
+    .is_err());
+  enforcer
+    .mutate_workspace_roles(
+      vec![(41, workspace_id)],
+      Box::pin(async { Ok(vec![Some(AFRole::Guest)]) }),
+    )
+    .await
+    .unwrap();
+  assert!(enforcer
+    .enforce_policy(&41, workspace.clone(), Action::Read)
+    .await
+    .unwrap());
+  assert!(!enforcer
+    .enforce_policy(&41, workspace, Action::Write)
+    .await
+    .unwrap());
+}
+
+#[tokio::test]
+async fn hyper_role_enforcement_waits_for_complete_replacement() {
+  let (enforcer, control) = hyper_failure_enforcer().await;
+  let workspace = ObjectType::Workspace("hyper-atomic-role".to_owned());
+  enforcer
+    .update_policy(SubjectType::User(41), workspace.clone(), AFRole::Member)
+    .await
+    .unwrap();
+  control.pause_remove.store(true, Ordering::SeqCst);
+  let update = {
+    let enforcer = enforcer.clone();
+    let workspace = workspace.clone();
+    tokio::spawn(async move {
+      enforcer
+        .update_policy(SubjectType::User(41), workspace, AFRole::Guest)
+        .await
+    })
+  };
+  tokio::time::timeout(Duration::from_secs(2), control.entered.notified())
+    .await
+    .unwrap();
+  let mut read = {
+    let enforcer = enforcer.clone();
+    let workspace = workspace.clone();
+    tokio::spawn(async move { enforcer.enforce_policy(&41, workspace, Action::Write).await })
+  };
+  assert!(tokio::time::timeout(Duration::from_millis(20), &mut read)
+    .await
+    .is_err());
+  control.resume.notify_one();
+  update.await.unwrap().unwrap();
+  assert!(!read.await.unwrap().unwrap());
+  assert!(enforcer
+    .enforce_policy(&41, workspace, Action::Read)
+    .await
+    .unwrap());
+}
+
+#[tokio::test]
