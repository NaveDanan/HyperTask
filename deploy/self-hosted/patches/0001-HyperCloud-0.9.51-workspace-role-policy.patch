+/// Keep role writes ordered at the server even while a cancelled SQLx future
+/// is draining its statement/COMMIT/ROLLBACK. Hash collisions only serialize
+/// otherwise independent keys; they do not change the SQL target identity.
+pub async fn hyper_lock_workspace_role_targets(
+  txn: &mut Transaction<'_, Postgres>,
+  targets: &[(i64, Uuid)],
+) -> Result<(), AppError> {
+  let mut keys = targets
+    .iter()
+    .map(|(uid, workspace)| (uid.to_string(), workspace.to_string()))
+    .collect::<Vec<_>>();
+  keys.sort();
+  keys.dedup();
+  for (uid, workspace) in keys {
+    let key = format!("hypertask:workspace-role:{}:{}", uid, workspace);
+    sqlx::query("SELECT pg_advisory_xact_lock(hashtextextended($1, 0))")
+      .bind(key)
+      .execute(txn.deref_mut())
+      .await?;
+  }
+  Ok(())
+}
+
+/// Read one committed PostgreSQL snapshot in the caller's target order.
+/// Business mutations call this after commit while their ACL key leases remain held.
+pub async fn hyper_select_committed_workspace_roles(
+  pool: &PgPool,
+  targets: &[(i64, Uuid)],
+) -> Result<Vec<Option<AFRole>>, AppError> {
+  let users = targets.iter().map(|(uid, _)| *uid).collect::<Vec<_>>();
+  let workspaces = targets
+    .iter()
+    .map(|(_, workspace)| *workspace)
+    .collect::<Vec<_>>();
+  let roles = sqlx::query_scalar::<_, Option<i32>>(
+    "SELECT membership.role_id
+     FROM UNNEST($1::bigint[], $2::uuid[]) WITH ORDINALITY
+       AS target(uid, workspace_id, target_ordinal)
+     LEFT JOIN public.af_workspace_member AS membership
+       ON membership.uid = target.uid AND membership.workspace_id = target.workspace_id
+     ORDER BY target.target_ordinal",
+  )
+  .bind(users)
+  .bind(workspaces)
+  .fetch_all(pool)
+  .await?;
+  roles
+    .into_iter()
+    .map(|role| match role {
+      None => Ok(None),
+      Some(1) => Ok(Some(AFRole::Owner)),
+      Some(2) => Ok(Some(AFRole::Member)),
+      Some(3) => Ok(Some(AFRole::Guest)),
+      Some(_) => Err(AppError::Internal(anyhow::anyhow!(
+        "unknown committed workspace role"
+      ))),
+    })
+    .collect()
+}
+
