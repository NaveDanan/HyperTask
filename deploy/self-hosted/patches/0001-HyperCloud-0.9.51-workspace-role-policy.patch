+//! Explicit disposable PostgreSQL proof, separate from the --lib unit suite.
+//! Parent must first verify its owned listener and create a NEW empty database
+//! named hyper_role_policy_test_<UUID>. Never point this target at appflowy.
+use database::workspace::{
