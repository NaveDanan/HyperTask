+++ b/libs/access-control/src/casbin/hyper_workspace_role_mutation_tests.rs
@@ -0,0 +1,382 @@
+//! The caller's future represents the external database commit/read boundary.
+//! These tests exercise the public workspace ACL without inspecting lock state.
+use super::{
+  access::AccessControl, enforcer::tests::test_enforcer, workspace::WorkspaceAccessControlImpl,
+};
+use crate::{act::Action, workspace::WorkspaceAccessControl};
+use app_error::AppError;
+use database_entity::dto::AFRole;
+use std::sync::{
+  atomic::{AtomicBool, AtomicU8, Ordering},
+  Arc,
+};
+use std::time::Duration;
+use tokio::sync::Notify;
+use uuid::Uuid;
+
+async fn hyper_acl() -> Arc<dyn WorkspaceAccessControl> {
+  Arc::new(WorkspaceAccessControlImpl::new(
+    AccessControl::with_enforcer(test_enforcer().await),
+  ))
+}
+
+#[tokio::test]
+async fn hyper_role_mutation_denies_before_database_poll_and_preserves_other_keys() {
+  let acl = hyper_acl().await;
+  let first = Uuid::new_v4();
+  let second = Uuid::new_v4();
+  acl.insert_role(&41, &first, AFRole::Member).await.unwrap();
+  acl.insert_role(&42, &first, AFRole::Member).await.unwrap();
+  acl.insert_role(&41, &second, AFRole::Member).await.unwrap();
+  assert!(acl.enforce_action(&41, &first, Action::Write).await.is_ok());
+  let observer = acl.clone();
+  tokio::time::timeout(
+    Duration::from_secs(2),
+    acl.mutate_workspace_roles(
+      vec![(41, first)],
+      Box::pin(async move {
+        assert!(observer
+          .enforce_action(&41, &first, Action::Write)
+          .await
+          .is_err());
+        assert!(observer
+          .enforce_action(&41, &first, Action::Read)
+          .await
+          .is_err());
+        assert!(observer
+          .enforce_action(&42, &first, Action::Write)
+          .await
+          .is_ok());
+        assert!(observer
+          .enforce_action(&41, &second, Action::Write)
+          .await
+          .is_ok());
+        Ok(vec![Some(AFRole::Guest)])
+      }),
+    ),
+  )
+  .await
+  .unwrap()
+  .unwrap();
+  assert!(acl.enforce_action(&41, &first, Action::Read).await.is_ok());
+  assert!(acl
+    .enforce_action(&41, &first, Action::Write)
+    .await
+    .is_err());
+}
+
+#[tokio::test]
+async fn hyper_role_database_updates_are_serialized_before_commit_not_just_policy_callbacks() {
+  let acl = hyper_acl().await;
+  let workspace = Uuid::new_v4();
+  acl
+    .insert_role(&41, &workspace, AFRole::Member)
+    .await
+    .unwrap();
+  let persisted = Arc::new(AtomicU8::new(2));
+  let entered = Arc::new(Notify::new());
+  let resume = Arc::new(Notify::new());
+  let older = {
+    let acl = acl.clone();
+    let persisted = persisted.clone();
+    let entered = entered.clone();
+    let resume = resume.clone();
+    tokio::spawn(async move {
+      acl
+        .mutate_workspace_roles(
+          vec![(41, workspace)],
+          Box::pin(async move {
+            entered.notify_one();
+            resume.notified().await;
+            persisted.store(2, Ordering::SeqCst);
+            Ok(vec![Some(AFRole::Member)])
+          }),
+        )
+        .await
+    })
+  };
+  tokio::time::timeout(Duration::from_secs(2), entered.notified())
+    .await
+    .unwrap();
+  let newer_started = Arc::new(Notify::new());
+  let newer_polled = Arc::new(Notify::new());
+  let newer = {
+    let acl = acl.clone();
+    let persisted = persisted.clone();
+    let started = newer_started.clone();
+    let polled = newer_polled.clone();
+    tokio::spawn(async move {
+      started.notify_one();
+      acl
+        .mutate_workspace_roles(
+          vec![(41, workspace)],
+          Box::pin(async move {
+            polled.notify_one();
+            persisted.store(3, Ordering::SeqCst);
+            Ok(vec![Some(AFRole::Guest)])
+          }),
+        )
+        .await
+    })
+  };
+  newer_started.notified().await;
+  assert!(
+    tokio::time::timeout(Duration::from_millis(20), newer_polled.notified())
+      .await
+      .is_err()
+  );
+  resume.notify_one();
+  older.await.unwrap().unwrap();
+  tokio::time::timeout(Duration::from_secs(2), newer)
+    .await
+    .unwrap()
+    .unwrap()
+    .unwrap();
+  assert_eq!(persisted.load(Ordering::SeqCst), 3);
+  assert!(acl
+    .enforce_action(&41, &workspace, Action::Read)
+    .await
+    .is_ok());
+  assert!(acl
+    .enforce_action(&41, &workspace, Action::Write)
+    .await
+    .is_err());
+}
+
+#[tokio::test]
+async fn hyper_role_cancel_after_database_commit_keeps_key_denied_until_authoritative_retry() {
+  let acl = hyper_acl().await;
+  let workspace = Uuid::new_v4();
+  acl
+    .insert_role(&41, &workspace, AFRole::Member)
+    .await
+    .unwrap();
+  let committed = Arc::new(Notify::new());
+  let persisted = Arc::new(AtomicU8::new(2));
+  let task = {
+    let acl = acl.clone();
+    let committed = committed.clone();
+    let persisted = persisted.clone();
+    tokio::spawn(async move {
+      acl
+        .mutate_workspace_roles(
+          vec![(41, workspace)],
+          Box::pin(async move {
+            persisted.store(3, Ordering::SeqCst);
+            committed.notify_one();
+            std::future::pending::<()>().await;
+            Ok(vec![Some(AFRole::Guest)])
+          }),
+        )
+        .await
+    })
+  };
+  tokio::time::timeout(Duration::from_secs(2), committed.notified())
+    .await
+    .unwrap();
+  assert_eq!(persisted.load(Ordering::SeqCst), 3);
+  task.abort();
+  assert!(task.await.unwrap_err().is_cancelled());
+  assert!(acl
+    .enforce_action(&41, &workspace, Action::Write)
+    .await
+    .is_err());
+  assert!(acl
+    .enforce_action(&41, &workspace, Action::Read)
+    .await
+    .is_err());
+  acl
+    .mutate_workspace_roles(
+      vec![(41, workspace)],
+      Box::pin(async { Ok(vec![Some(AFRole::Guest)]) }),
+    )
+    .await
+    .unwrap();
+  assert!(acl
+    .enforce_action(&41, &workspace, Action::Read)
+    .await
+    .is_ok());
+  assert!(acl
+    .enforce_action(&41, &workspace, Action::Write)
+    .await
+    .is_err());
+}
+
+#[tokio::test]
+async fn hyper_role_database_failure_and_wrong_result_count_leave_previous_member_denied() {
+  for bad_count in [false, true] {
+    let acl = hyper_acl().await;
+    let workspace = Uuid::new_v4();
+    acl
+      .insert_role(&41, &workspace, AFRole::Member)
+      .await
+      .unwrap();
+    let result = acl
+      .mutate_workspace_roles(
+        vec![(41, workspace)],
+        Box::pin(async move {
+          if bad_count {
+            Ok(vec![])
+          } else {
+            Err(AppError::Internal(anyhow::anyhow!(
+              "database commit result uncertain"
+            )))
+          }
+        }),
+      )
+      .await;
+    assert!(result.is_err());
+    assert!(acl
+      .enforce_action(&41, &workspace, Action::Read)
+      .await
+      .is_err());
+    assert!(acl
+      .enforce_action(&41, &workspace, Action::Write)
+      .await
+      .is_err());
+  }
+}
+
+#[tokio::test]
+async fn hyper_role_stale_completion_cannot_replace_or_clear_a_newer_role_generation() {
+  let acl = hyper_acl().await;
+  let workspace = Uuid::new_v4();
+  acl
+    .insert_role(&41, &workspace, AFRole::Member)
+    .await
+    .unwrap();
+  let entered = Arc::new(Notify::new());
+  let resume = Arc::new(Notify::new());
+  let older = {
+    let acl = acl.clone();
+    let entered = entered.clone();
+    let resume = resume.clone();
+    tokio::spawn(async move {
+      acl
+        .mutate_workspace_roles(
+          vec![(41, workspace)],
+          Box::pin(async move {
+            entered.notify_one();
+            resume.notified().await;
+            Ok(vec![Some(AFRole::Member)])
+          }),
+        )
+        .await
+    })
+  };
+  tokio::time::timeout(Duration::from_secs(2), entered.notified())
+    .await
+    .unwrap();
+  // The trusted bootstrap interface simulates a newer policy generation. An
+  // older asynchronous callback must not overwrite it or clear its token.
+  assert!(acl
+    .insert_role(&41, &workspace, AFRole::Member)
+    .await
+    .is_err());
+  acl
+    .remove_user_from_workspace(&41, &workspace)
+    .await
+    .unwrap();
+  acl
+    .insert_role(&41, &workspace, AFRole::Guest)
+    .await
+    .unwrap();
+  resume.notify_one();
+  assert!(older.await.unwrap().is_err());
+  assert!(acl
+    .enforce_action(&41, &workspace, Action::Read)
+    .await
+    .is_ok());
+  assert!(acl
+    .enforce_action(&41, &workspace, Action::Write)
+    .await
+    .is_err());
+}
+
+#[tokio::test]
+async fn hyper_role_reversed_batches_do_not_deadlock_and_keep_original_result_order() {
+  let acl = hyper_acl().await;
+  let first = Uuid::new_v4();
+  let second = Uuid::new_v4();
+  acl.insert_role(&41, &first, AFRole::Member).await.unwrap();
+  acl.insert_role(&42, &second, AFRole::Member).await.unwrap();
+  let entered = Arc::new(Notify::new());
+  let resume = Arc::new(Notify::new());
+  let a = {
+    let acl = acl.clone();
+    let entered = entered.clone();
+    let resume = resume.clone();
+    tokio::spawn(async move {
+      acl
+        .mutate_workspace_roles(
+          vec![(42, second), (41, first)],
+          Box::pin(async move {
+            entered.notify_one();
+            resume.notified().await;
+            Ok(vec![Some(AFRole::Guest), Some(AFRole::Member)])
+          }),
+        )
+        .await
+    })
+  };
+  tokio::time::timeout(Duration::from_secs(2), entered.notified())
+    .await
+    .unwrap();
+  let second_started = Arc::new(Notify::new());
+  let b = {
+    let acl = acl.clone();
+    let second_started = second_started.clone();
+    tokio::spawn(async move {
+      second_started.notify_one();
+      acl
+        .mutate_workspace_roles(
+          vec![(41, first), (42, second)],
+          Box::pin(async { Ok(vec![Some(AFRole::Guest), Some(AFRole::Member)]) }),
+        )
+        .await
+    })
+  };
+  second_started.notified().await;
+  resume.notify_one();
+  a.await.unwrap().unwrap();
+  tokio::time::timeout(Duration::from_secs(2), b)
+    .await
+    .unwrap()
+    .unwrap()
+    .unwrap();
+  assert!(acl
+    .enforce_action(&41, &first, Action::Write)
+    .await
+    .is_err());
+  assert!(acl
+    .enforce_action(&42, &second, Action::Write)
+    .await
+    .is_ok());
+}
+
+#[tokio::test]
+async fn hyper_role_duplicate_targets_reject_before_database_poll() {
+  let acl = hyper_acl().await;
+  let workspace = Uuid::new_v4();
+  let polled = Arc::new(AtomicBool::new(false));
+  acl
+    .insert_role(&41, &workspace, AFRole::Member)
+    .await
+    .unwrap();
+  let flag = polled.clone();
+  assert!(acl
+    .mutate_workspace_roles(
+      vec![(41, workspace), (41, workspace)],
+      Box::pin(async move {
+        flag.store(true, Ordering::SeqCst);
+        Ok(vec![None, None])
+      })
+    )
+    .await
+    .is_err());
+  assert!(!polled.load(Ordering::SeqCst));
+  assert!(acl
+    .enforce_action(&41, &workspace, Action::Write)
+    .await
+    .is_ok());
+}
