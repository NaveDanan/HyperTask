+use sqlx::{
+  postgres::{PgConnectOptions, PgPoolOptions},
+  PgPool,
+};
+use std::{ops::DerefMut, str::FromStr, sync::Arc, time::Duration};
+use tokio::sync::Notify;
+use uuid::Uuid;
+
+const HYPER_COMMIT_GATE: i64 = 7239571004488111;
+
+async fn hyper_pool() -> PgPool {
+  let value = std::env::var("HYPER_ROLE_TEST_DATABASE_URL")
+    .expect("Supply only a newly created private hyper_role_policy_test_<UUID> database");
+  let options = PgConnectOptions::from_str(&value)
+    .unwrap_or_else(|_| panic!("Invalid private test database options"));
+  assert_eq!(
+    options.get_host(),
+    "127.0.0.1",
+    "Only the verified disposable loopback server is supported"
+  );
+  let name = options
+    .get_database()
+    .expect("Explicit disposable database required");
+  let suffix = name
+    .strip_prefix("hyper_role_policy_test_")
+    .expect("Refusing a non-test database");
+  assert!(
+    Uuid::parse_str(suffix).is_ok(),
+    "A fresh UUID database name is required"
+  );
+  PgPoolOptions::new()
+    .max_connections(5)
+    .acquire_timeout(Duration::from_secs(3))
+    .connect_with(options)
+    .await
+    .unwrap_or_else(|_| panic!("Cannot connect to private role test database"))
+}
+
+async fn hyper_wait_commit_is_server_blocked(pool: &PgPool, pid: i32) {
+  tokio::time::timeout(Duration::from_secs(3), async {
+    loop {
+      let blocked = sqlx::query_scalar::<_, bool>(
+        "SELECT EXISTS (SELECT 1 FROM pg_stat_activity WHERE pid = $1 AND wait_event_type = 'Lock' AND wait_event = 'advisory')",
+      ).bind(pid).fetch_one(pool).await.unwrap();
+      if blocked { break; }
+      tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+  }).await.expect("Older COMMIT must actually be blocked inside PostgreSQL before cancellation");
+}
+
+#[tokio::test]
+async fn hyper_role_transaction_lock_orders_canceled_commit_before_newer_guest() {
+  let pool = hyper_pool().await;
+  let relations = sqlx::query_scalar::<_, i64>(
+    "SELECT COUNT(*) FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
+     WHERE n.nspname NOT IN ('pg_catalog','information_schema') AND n.nspname NOT LIKE 'pg_toast%'
+       AND n.nspname NOT LIKE 'pg_temp_%' AND c.relkind IN ('r','p','v','m','S','f')",
+  ).fetch_one(&pool).await.unwrap();
+  assert_eq!(
+    relations, 0,
+    "Refusing a database containing existing relations"
+  );
+  // No IF NOT EXISTS: this target refuses a database containing an old test or
+  // user tables. The caller owns creation and later removal of this database.
+  sqlx::query(
+    "CREATE TABLE public.af_workspace (workspace_id uuid PRIMARY KEY, owner_uid bigint NOT NULL)",
+  )
+  .execute(&pool)
+  .await
+  .unwrap();
+  sqlx::query("CREATE TABLE public.af_workspace_member (workspace_id uuid NOT NULL, uid bigint NOT NULL, role_id integer NOT NULL, PRIMARY KEY (workspace_id, uid))")
+    .execute(&pool).await.unwrap();
+  let workspace = Uuid::new_v4();
+  let other_workspace = Uuid::new_v4();
+  for id in [workspace, other_workspace] {
+    sqlx::query("INSERT INTO public.af_workspace VALUES ($1, 99)")
+      .bind(id)
+      .execute(&pool)
+      .await
+      .unwrap();
+  }
+  sqlx::query("INSERT INTO public.af_workspace_member VALUES ($1,41,3),($1,42,2),($2,41,2)")
+    .bind(workspace)
+    .bind(other_workspace)
+    .execute(&pool)
+    .await
+    .unwrap();
+  assert_eq!(
+    hyper_select_committed_workspace_roles(
+      &pool,
+      &[(41, other_workspace), (77, workspace), (41, workspace)]
+    )
+    .await
+    .unwrap(),
+    vec![Some(AFRole::Member), None, Some(AFRole::Guest)]
+  );
+
+  // A test-only deferred write makes the old Member change occur inside COMMIT,
+  // after its Rust future is aborted. It intentionally has no membership row
+  // lock yet, so removing the production advisory lock makes this proof fail.
+  sqlx::query("CREATE TABLE public.hyper_delayed_role_updates (workspace_id uuid NOT NULL, uid bigint NOT NULL)")
+    .execute(&pool).await.unwrap();
+  sqlx::query(&format!("CREATE FUNCTION public.hyper_hold_role_commit() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN PERFORM pg_advisory_xact_lock({HYPER_COMMIT_GATE}::bigint); UPDATE public.af_workspace_member SET role_id=2 WHERE workspace_id=NEW.workspace_id AND uid=NEW.uid; RETURN NEW; END $$"))
+    .execute(&pool).await.unwrap();
+  sqlx::query("CREATE CONSTRAINT TRIGGER hyper_delay_role_commit AFTER INSERT ON public.hyper_delayed_role_updates DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.hyper_hold_role_commit()")
+    .execute(&pool).await.unwrap();
+  let mut commit_gate = pool.acquire().await.unwrap();
+  sqlx::query("SELECT pg_advisory_lock($1)")
+    .bind(HYPER_COMMIT_GATE)
+    .execute(commit_gate.deref_mut())
+    .await
+    .unwrap();
+  let mut old_tx = pool.begin().await.unwrap();
+  let old_pid = sqlx::query_scalar::<_, i32>("SELECT pg_backend_pid()")
+    .fetch_one(old_tx.deref_mut())
+    .await
+    .unwrap();
+  hyper_lock_workspace_role_targets(&mut old_tx, &[(41, workspace)])
+    .await
+    .unwrap();
+  sqlx::query("INSERT INTO public.hyper_delayed_role_updates VALUES ($1,41)")
+    .bind(workspace)
+    .execute(old_tx.deref_mut())
+    .await
+    .unwrap();
+  let old_commit = tokio::spawn(async move { old_tx.commit().await });
+  hyper_wait_commit_is_server_blocked(&pool, old_pid).await;
+  old_commit.abort();
+  assert!(old_commit.await.unwrap_err().is_cancelled());
+
+  let new_started = Arc::new(Notify::new());
+  let newer = {
+    let pool = pool.clone();
+    let new_started = new_started.clone();
+    tokio::spawn(async move {
+      let mut txn = pool.begin().await.unwrap();
+      new_started.notify_one();
+      hyper_lock_workspace_role_targets(&mut txn, &[(41, workspace)])
+        .await
+        .unwrap();
+      upsert_workspace_member(&mut txn, &workspace, &41, AFRole::Guest)
+        .await
+        .unwrap();
+      txn.commit().await.unwrap();
+    })
+  };
+  new_started.notified().await;
+  let mut newer = newer;
+  assert!(
+    tokio::time::timeout(Duration::from_millis(30), &mut newer)
+      .await
+      .is_err(),
+    "New mutation must not overtake the older uncertain server COMMIT"
+  );
+  sqlx::query("SELECT pg_advisory_unlock($1)")
+    .bind(HYPER_COMMIT_GATE)
+    .execute(commit_gate.deref_mut())
+    .await
+    .unwrap();
+  tokio::time::timeout(Duration::from_secs(3), newer)
+    .await
+    .unwrap()
+    .unwrap();
+  let actual = hyper_select_committed_workspace_roles(
+    &pool,
+    &[(41, workspace), (42, workspace), (41, other_workspace)],
+  )
+  .await
+  .unwrap();
+  assert_eq!(
+    actual,
+    vec![
+      Some(AFRole::Guest),
+      Some(AFRole::Member),
+      Some(AFRole::Member)
+    ]
+  );
+  // A fresh connection confirms the final committed result rather than a local
+  // policy cache or a successful request acknowledgment.
+  let mut cold = pool.acquire().await.unwrap();
+  let role = sqlx::query_scalar::<_, i32>(
+    "SELECT role_id FROM public.af_workspace_member WHERE workspace_id=$1 AND uid=41",
+  )
+  .bind(workspace)
+  .fetch_one(cold.deref_mut())
+  .await
+  .unwrap();
+  assert_eq!(role, 3);
+  drop(cold);
+  drop(commit_gate);
+  pool.close().await;
+}
