FROM golang:1.23.6-bookworm AS builder
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /auth .
FROM alpine:3.20.6
RUN apk add --no-cache ca-certificates curl && adduser -D -u 1000 supabase
WORKDIR /app
COPY --from=builder /auth /app/auth
COPY --from=builder /src/migrations /app/migrations
USER supabase
ENV PORT=9999
EXPOSE 9999
CMD ["sh", "-c", "./auth migrate && exec ./auth"]