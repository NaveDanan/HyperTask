     "blockId": "OuIJU-",
     "children": [
      {
       "children": [
        {
         "text": "There is an approach called \"working backwards\" that is widely used at Amazon. We try to work backwards from the customer, rather than starting with an idea for a product and trying to bolt customers onto it. While working backwards can be applied to any specific product decision, using this approach is especially important when developing new products or features."
        }
       ],
       "textId": "CySj4v",
       "type": "text"
      }
