      "text_map": {
       "00lU7M": "[]",
       "00t7zX": "[{\"insert\":\"Our software helps marketing and product managers in businesses of all sizes plan, track, and manage their projects more efficiently.\",\"attributes\":{\"font_family\":\"Playfair Display\",\"bold\":true}}]",
       "0I9USt": "[{\"insert\":\"Project management processes are often time-consuming and inefficient, leading to missed deadlines and wasted resources.\",\"attributes\":{\"font_family\":\"Playfair Display\",\"bold\":true}}]",
       "28ac19": "[]",
       "4bRB3R": "[{\"insert\":\"THE SOLUTION:\",\"attributes\":{\"bold\":true,\"font_family\":\"Playfair Display\"}}]",
       "5SBpVh": "[]",
       "5UwO0h": "[{\"insert\":\"THE BENEFITS: \",\"attributes\":{\"font_family\":\"Playfair Display\",\"bold\":false}}]",
       "5lgr8B": "[]",
       "7qkDt3": "[{\"insert\":\"Request a demo to learn more about how our software can help your team run smoother than ever before.\",\"attributes\":{\"bold\":true,\"font_family\":\"Playfair Display\"}}]",
       "8-QIRv": "[{\"insert\":\"Easy to use: Our software is designed to be intuitive, even for non-technical users.Flexible: Our tool is customizable to meet the specific needs of any project. Resource allocation: Teams can track and allocate resources such as people, time, and budgets.Risk management: Teams can identify risks at a glance and mitigate issues proactively, saving time and money.\",\"attributes\":{\"font_family\":\"Playfair Display\",\"bold\":false}}]",
       "8_87l3": "[{\"insert\":\"Project Zen is a project management company that uses AI to save teams time and resources.\",\"attributes\":{\"font_family\":\"Playfair Display\",\"bold\":true}}]",
       "9_2hTV": "[]",
       "FjFW8V": "[]",
       "H3C5Rm": "[{\"insert\":\"WHO WE ARE:\",\"attributes\":{\"font_family\":\"Playfair Display\",\"bold\":true}}]",
       "NR5msz": "[]",
       "VKxPFX": "[]",
       "YmzNT8": "[]",
       "aMrI34": "[{\"insert\":\"THE PROBLEM: \",\"attributes\":{\"font_family\":\"Playfair Display\",\"bold\":true}}]",
       "ccTpDJ": "[]",
       "gPJSEG": "[{\"insert\":\"contact@projectzen.com\",\"attributes\":{\"underline\":false,\"font_family\":\"Playfair Display\",\"bold\":false,\"href\":\"contact@projectzen.com\"}},{\"insert\":\"   |   (123) 456-7890\",\"attributes\":{\"bold\":false,\"underline\":false,\"font_family\":\"Playfair Display\"}}]",
       "kYfQu7": "[{\"insert\":\"WHAT'S NEXT: \",\"attributes\":{\"font_family\":\"Playfair Display\",\"bold\":true}}]",
       "nPz0zu": "[]",
       "sX0F8q": "[{\"insert\":\"We're committed to providing our customers with the best possible experience. In the next year, we plan to launch a new customer support portal and expand our product offerings.\",\"attributes\":{\"font_family\":\"Playfair Display\",\"bold\":true}}]"
      }
