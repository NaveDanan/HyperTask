        "text_map": {
         "DpmIPD": "[{\"insert\":\"Unfortunately, time was cut short on some design elements that needed to be pushed to next week's sprint.  Will update the backlog accordingly.\"}]",
         "QfTUWM": "[{\"insert\":\"For the next sprint we will be more mindful of the number of story points in the Sprint Backlog due to our reduced team size with Henry's paternity leave over the next 3 months.\"}]",
         "TsCd1j": "[{\"insert\":\"This sprint saw the release of the plugin infrastructure that was hindering 3rd party integrations.\"}]"
        }
