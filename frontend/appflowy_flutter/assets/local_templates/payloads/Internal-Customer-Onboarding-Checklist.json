    {
     "blockId": "HiEX73",
     "children": [
      {
       "children": [
        {
         "text": "Here, you’ll fill in the action items that your customer success team members or account managers will need to take in order to onboard a new customer. We’ve pre-populated a list of actions, but you’ll need to add, delete, or specify certain items depending upon your company’s product or service."
        }
       ],
       "textId": "QDKRFb",
       "type": "text"
      }
     ],
     "data": {},
     "relationId": "bPjMtT",
