       "id": "SC0XdU",
       "is_primary": false,
       "last_modified": "1791889237",
       "name": "Progress bar",
       "ty": 19,
       "type_option": {
        "0": {},
        "19": {
         "expression": "if((empty(prop(\"planned\")) or prop(\"planned\") <= 0), \"Set a target\", lets(p, prop(\"cWec1n\"), filled, floor(p * 10), repeat(\"■\", filled) + repeat(\"□\", 10 - filled) + \" \" + format(round(p * 100)) + \"%\"))",
         "format": 0
        }
       }
      },
      "bhtWlI": {
       "created_at": "1791889237",
       "icon": "",
       "id": "bhtWlI",
       "is_primary": false,
       "last_modified": "1791889242",
       "name": "Focus",
       "ty": 19,
       "type_option": {
        "0": {},
        "19": {
         "expression": "ifs(prop(\"tags\").includes(\"Blocked\"), \"Unblock first\", (empty(prop(\"planned\")) or prop(\"planned\") <= 0), \"Plan scope\", prop(\"completed\") >= prop(\"planned\"), \"Done\", \"Keep moving\")",
         "format": 0
        }
       }
      },
      "cWec1n": {
       "created_at": "1791889226",
       "icon": "",
       "id": "cWec1n",
       "is_primary": false,
       "last_modified": "1791889231",
       "name": "Progress",
       "ty": 19,
       "type_option": {
        "0": {},
        "19": {
         "expression": "if((empty(prop(\"planned\")) or prop(\"planned\") <= 0), empty(), min(1, max(0, prop(\"completed\") / prop(\"planned\"))))",
         "format": 36
        }
       }
      },
