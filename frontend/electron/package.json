    "@tiptap/extension-italic": "3.35.0",
    "@tiptap/extension-list": "3.35.0",
    "@tiptap/extension-paragraph": "3.35.0",
    "@tiptap/extension-strike": "3.35.0",
    "@tiptap/extension-task-item": "3.35.0",
    "@tiptap/extension-task-list": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "culori": "^4.0.2",
    "date-fns": "4.4.0",
    "effect": "4.1.3",
    "gt-i18n": "1.0.40",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.1",
    "shiki": "4.6.0",
    "sonner": "^2.0.8",
