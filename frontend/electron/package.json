    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "44.10.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron@44.10.2": true,
    "keytar@7.9.0": true,
    "@azure/msal-node-extensions@5.6.2": true
  }
}
