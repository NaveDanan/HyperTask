{
  "name": "hypertask",
  "productName": "HyperTask",
  "version": "0.11.4",
  "private": true,
  "author": "NaveDanan",
  "description": "HyperTask desktop workspace, developed by NaveDanan",
  "main": "out/main/index.js",
  "scripts": {
    "gen:proto": "node scripts/gen-proto.mjs",
    "gen:events": "node scripts/gen-events.mjs",
    "gen": "npm run gen:proto && npm run gen:events",
    "build:core": "node scripts/build-core.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "harness:compile": "tsc -p scripts/web-harness/tsconfig.json",
    "harness": "node scripts/web-harness/server.cjs",
    "harness:shot": "node scripts/web-harness/screenshot.mjs",
    "harness:seed": "node scripts/web-harness/hyper-views.mjs seed",
    "harness:view": "node scripts/web-harness/hyper-views.mjs shot",
    "harness:smoke": "vitest run --config scripts/web-harness/live.config.ts",
    "build:desktop": "npm run build && electron-builder --dir",
    "dev:jwt": "node scripts/HyperDevJwtLogin.mjs"
  },
  "dependencies": {
    "@a2ui/agent": "^0.2.1",
    "@a2ui/react": "^0.16.1",
    "@a2ui/web_core": "^0.16.1",
    "@azure/msal-node": "7.2.2",
    "@azure/msal-node-extensions": "5.6.2",
    "@base-ui/react": "^1.9.0",
    "@bufbuild/protobuf": "^2.17.0",
    "@date-fns/tz": "1.5.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@effect/platform-node": "4.1.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/hashes": "^1.8.0",
    "@streamdown/code": "2.0.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-blockquote": "3.35.0",
    "@tiptap/extension-bold": "3.35.0",
    "@tiptap/extension-code": "3.35.0",
